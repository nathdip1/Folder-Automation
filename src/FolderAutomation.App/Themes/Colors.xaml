<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Application backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="#F5F7FA"/>

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SurfaceSecondaryBrush"
                     Color="#F8FAFC"/>

    <!-- Navigation -->
    <SolidColorBrush x:Key="SidebarBrush"
                     Color="#111827"/>

    <SolidColorBrush x:Key="SidebarHoverBrush"
                     Color="#1F2937"/>

    <SolidColorBrush x:Key="SidebarSelectedBrush"
                     Color="#2563EB"/>

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="#2563EB"/>

    <SolidColorBrush x:Key="PrimaryHoverBrush"
                     Color="#1D4ED8"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#111827"/>

    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#6B7280"/>

    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#9CA3AF"/>

    <SolidColorBrush x:Key="OnPrimaryBrush"
                     Color="#FFFFFF"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#E5E7EB"/>

    <SolidColorBrush x:Key="DividerBrush"
                     Color="#E5E7EB"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#16A34A"/>

    <SolidColorBrush x:Key="WarningBrush"
                     Color="#D97706"/>

    <SolidColorBrush x:Key="ErrorBrush"
                     Color="#DC2626"/>

</ResourceDictionary>