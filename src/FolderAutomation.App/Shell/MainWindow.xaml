<Window x:Class="FolderAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:folderOrganizer="clr-namespace:FolderAutomation.Features.FolderOrganizer"
        xmlns:fileConverter="clr-namespace:FolderAutomation.Features.FileConverter"
        Title="Folder Automation"
        Icon="/FolderAutomation;component/Assets/app.ico"
        Height="760"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FeatureExpanderStyle"
               TargetType="{x:Type Expander}">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Padding="4,2"
                                   Foreground="{StaticResource PrimaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Path=IsExpanded}"
                                            Value="True">
                                            <Setter Property="FontSize" Value="15"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Folder Automation"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Automate repetitive file and folder tasks"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="16"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="Ready"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16,22,16,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Feature navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Features"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Choose an automation tool"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,22,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Folder Organizer -->
                            <Expander x:Name="FolderOrganizerExpander"
                                      Header="Folder Organizer"
                                      IsExpanded="False"
                                      Expanded="FeatureExpander_Expanded"
                                      Style="{StaticResource FeatureExpanderStyle}"
                                      Margin="0,0,0,8">
                                <StackPanel Margin="12,4,12,14">
                                    <TextBlock Text="FOLDER"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,8,0,8"/>

                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Selected Folder"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="SelectedFolderText"
                                                       Text="No folder selected"
                                                       Margin="0,5,0,12"
                                                       FontSize="13"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Content="Select Folder"
                                                    Height="38"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    Foreground="{StaticResource OnPrimaryBrush}"
                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                    Click="SelectFolderButton_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="ACTIONS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,18,0,8"/>

                                    <TextBlock Text="WHEN A DESTINATION FILE ALREADY EXISTS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,6"/>

                                    <ComboBox x:Name="ConflictActionComboBox"
                                              Height="40"
                                              SelectedIndex="0"
                                              Padding="12,0"
                                              Background="{StaticResource SurfaceBrush}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              BorderThickness="1"
                                              FontSize="13"
                                              FocusVisualStyle="{x:Null}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Ask me each time"/>
                                        <ComboBoxItem Content="Rename incoming file"/>
                                        <ComboBoxItem Content="Skip incoming file"/>
                                        <ComboBoxItem Content="Replace existing file"/>
                                    </ComboBox>

                                    <Button Content="Organize Files"
                                            Height="40"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="{StaticResource OnPrimaryBrush}"
                                            BorderBrush="{StaticResource PrimaryBrush}"
                                            Click="OrganizeFilesButton_Click"/>

                                    <Button Content="Undo Last Operation"
                                            Height="40"
                                            Margin="0,8,0,0"
                                            Background="{StaticResource SurfaceBrush}"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            Click="UndoButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- File Renamer placeholder -->
                            <Expander Header="File Renamer"
                                      Expanded="FeatureExpander_Expanded"
                                      Style="{StaticResource FeatureExpanderStyle}"
                                      Margin="0,0,0,8">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Rename multiple files using rules."
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Coming soon"
                                               Margin="0,10,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Expander>

                            <!-- File Converter -->
                            <Expander Header="File Converter"
                                      Expanded="FeatureExpander_Expanded"
                                      Style="{StaticResource FeatureExpanderStyle}"
                                      Margin="0,0,0,8">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Resize and optimize photos for online applications."
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Select this feature to open the photo converter."
                                               Margin="0,10,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>

                            <!-- File Cleaner placeholder -->
                            <Expander Header="File Cleaner"
                                      Expanded="FeatureExpander_Expanded"
                                      Style="{StaticResource FeatureExpanderStyle}"
                                      Margin="0,0,0,8">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Find and clean unnecessary files."
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Coming soon"
                                               Margin="0,10,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Expander>

                            <!-- More tools placeholder -->
                            <Expander Header="More Automation Tools"
                                      Expanded="FeatureExpander_Expanded"
                                      Style="{StaticResource FeatureExpanderStyle}">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Additional automation features will appear here."
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Feature views -->
            <Grid Grid.Column="2">

                <folderOrganizer:FolderOrganizerView
                    x:Name="FolderOrganizerViewControl"
                    Visibility="Visible"/>

                <fileConverter:FileConverterView
                    x:Name="FileConverterViewControl"
                    Visibility="Collapsed"/>

            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="Folder Automation"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>