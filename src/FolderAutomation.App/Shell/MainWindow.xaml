<Window x:Class="FolderAutomation.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Folder Automation"

        Icon="/FolderAutomation;component/Assets/app.ico"

        Height="760"

        Width="1200"

        MinHeight="650"

        MinWidth="1000"

        WindowStartupLocation="CenterScreen">

    <!-- ========================================================= -->

    <!-- WINDOW RESOURCES -->

    <!-- ========================================================= -->

    <Window.Resources>

        <!-- Common feature Expander header -->

        <Style x:Key="FeatureExpanderStyle"

               TargetType="{x:Type Expander}">

            <Setter Property="Background"

                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"

                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"

                    Value="1"/>

            <Setter Property="HeaderTemplate">

                <Setter.Value>

                    <DataTemplate>

                        <TextBlock Text="{Binding}"

                                   Padding="4,2"

                                   Foreground="{StaticResource PrimaryTextBrush}">

                            <TextBlock.Style>

                                <Style TargetType="{x:Type TextBlock}">

                                    <!-- COLLAPSED STATE -->

                                    <Setter Property="FontSize"

                                            Value="14"/>

                                    <Setter Property="FontWeight"

                                            Value="Normal"/>

                                    <Style.Triggers>

                                        <!-- EXPANDED STATE -->

                                        <DataTrigger

                                            Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Path=IsExpanded}"

                                            Value="True">

                                            <Setter Property="FontSize"

                                                    Value="15"/>

                                            <Setter Property="FontWeight"

                                                    Value="SemiBold"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </DataTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="72"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="34"/>

        </Grid.RowDefinitions>

        <!-- ===================================================== -->

        <!-- TOP BAR -->

        <!-- ===================================================== -->

        <Border Grid.Row="0"

                Background="{StaticResource SurfaceBrush}"

                BorderBrush="{StaticResource BorderBrush}"

                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"

                            VerticalAlignment="Center">

                    <TextBlock Text="Folder Automation"

                               FontSize="21"

                               FontWeight="SemiBold"

                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Automate repetitive file and folder tasks"

                               Margin="0,2,0,0"

                               FontSize="12"

                               Foreground="{StaticResource SecondaryTextBrush}"/>

                </StackPanel>

                <Border Grid.Column="1"

                        Padding="12,6"

                        CornerRadius="16"

                        Background="{StaticResource SurfaceSecondaryBrush}"

                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"

                                 Height="8"

                                 Fill="{StaticResource SuccessBrush}"

                                 VerticalAlignment="Center"

                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Ready"

                                   FontSize="12"

                                   FontWeight="SemiBold"

                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ===================================================== -->

        <!-- MAIN CONTENT -->

        <!-- ===================================================== -->

        <Grid Grid.Row="1"

              Margin="16,22,16,18">

            <Grid.ColumnDefinitions>

                <!-- Feature navigation -->

                <ColumnDefinition Width="330"/>

                <!-- Gap -->

                <ColumnDefinition Width="16"/>

                <!-- Results -->

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- ================================================= -->

            <!-- LEFT FEATURE PANEL -->

            <!-- ================================================= -->

            <Border Grid.Column="0"

                    Background="{StaticResource SurfaceBrush}"

                    BorderBrush="{StaticResource BorderBrush}"

                    BorderThickness="1"

                    CornerRadius="10">

                <Grid Margin="22">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- Feature header -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Features"

                                   FontSize="20"

                                   FontWeight="SemiBold"

                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Choose an automation tool"

                                   Margin="0,4,0,0"

                                   FontSize="12"

                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <!-- Feature list -->

                    <ScrollViewer Grid.Row="1"

                                  Margin="0,22,0,0"

                                  VerticalScrollBarVisibility="Auto"

                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- ================================= -->

                            <!-- FEATURE 1: FOLDER ORGANIZER -->

                            <!-- ================================= -->

                            <Expander x:Name="FolderOrganizerExpander"

                                      Header="Folder Organizer"

                                      IsExpanded="False"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}"

                                      Margin="0,0,0,8">

                                <StackPanel Margin="12,4,12,14">

                                    <!-- Folder -->

                                    <TextBlock Text="FOLDER"

                                               FontSize="11"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               Margin="0,8,0,8"/>

                                    <Border Background="{StaticResource SurfaceBrush}"

                                            BorderBrush="{StaticResource BorderBrush}"

                                            BorderThickness="1"

                                            CornerRadius="7"

                                            Padding="14">

                                        <StackPanel>

                                            <TextBlock Text="Selected Folder"

                                                       FontSize="11"

                                                       FontWeight="SemiBold"

                                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock x:Name="SelectedFolderText"

                                                       Text="No folder selected"

                                                       Margin="0,5,0,12"

                                                       FontSize="13"

                                                       Foreground="{StaticResource PrimaryTextBrush}"

                                                       TextWrapping="Wrap"

                                                       TextTrimming="CharacterEllipsis"/>

                                            <Button Content="Select Folder"

                                                    Height="38"

                                                    Background="{StaticResource PrimaryBrush}"

                                                    Foreground="{StaticResource OnPrimaryBrush}"

                                                    BorderBrush="{StaticResource PrimaryBrush}"

                                                    Click="SelectFolderButton_Click"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- Actions -->

                                    <TextBlock Text="ACTIONS"

                                               FontSize="11"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               Margin="0,18,0,8"/>

                                    <TextBlock Text="WHEN A DESTINATION FILE ALREADY EXISTS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,0,6"/>

                                    <ComboBox x:Name="ConflictActionComboBox"
                                              Height="40"
                                              SelectedIndex="0"
                                              Padding="12,0"
                                              Background="{StaticResource SurfaceBrush}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              BorderThickness="1"
                                              FontSize="13"
                                              FocusVisualStyle="{x:Null}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center">
                                        <ComboBox.Resources>
                                            <Style TargetType="{x:Type ComboBoxItem}">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource PrimaryTextBrush}"/>
                                                <Setter Property="Background"
                                                        Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="Padding"
                                                        Value="12,9"/>
                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Stretch"/>
                                                <Setter Property="BorderThickness"
                                                        Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource SurfaceSecondaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OnPrimaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="Ask me each time"/>
                                        <ComboBoxItem Content="Rename incoming file"/>
                                        <ComboBoxItem Content="Skip incoming file"/>
                                        <ComboBoxItem Content="Replace existing file"/>
                                    </ComboBox>

                                    <Button Content="Organize Files"

                                            Height="40"

                                            Background="{StaticResource PrimaryBrush}"

                                            Foreground="{StaticResource OnPrimaryBrush}"

                                            BorderBrush="{StaticResource PrimaryBrush}"

                                            Click="OrganizeFilesButton_Click"/>

                                    <Button Content="Undo Last Operation"

                                            Height="40"

                                            Margin="0,8,0,0"

                                            Background="{StaticResource SurfaceBrush}"

                                            Foreground="{StaticResource PrimaryTextBrush}"

                                            BorderBrush="{StaticResource BorderBrush}"

                                            Click="UndoButton_Click"/>

                                </StackPanel>

                            </Expander>

                            <!-- ================================= -->

                            <!-- FEATURE 2 -->

                            <!-- ================================= -->

                            <Expander Header="Duplicate Finder"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}"

                                      Margin="0,0,0,8">

                                <StackPanel Margin="14">

                                    <TextBlock Text="Find duplicate files in a folder."

                                               FontSize="12"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Coming soon"

                                               Margin="0,10,0,0"

                                               FontSize="12"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Expander>

                            <!-- ================================= -->

                            <!-- FEATURE 3 -->

                            <!-- ================================= -->

                            <Expander Header="File Renamer"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}"

                                      Margin="0,0,0,8">

                                <StackPanel Margin="14">

                                    <TextBlock Text="Rename multiple files using rules."

                                               FontSize="12"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Coming soon"

                                               Margin="0,10,0,0"

                                               FontSize="12"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Expander>

                            <!-- ================================= -->

                            <!-- FEATURE 4 -->

                            <!-- ================================= -->

                            <Expander Header="File Converter"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}"

                                      Margin="0,0,0,8">

                                <StackPanel Margin="14">

                                    <TextBlock Text="Convert files between supported formats."

                                               FontSize="12"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Coming soon"

                                               Margin="0,10,0,0"

                                               FontSize="12"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Expander>

                            <!-- ================================= -->

                            <!-- FEATURE 5 -->

                            <!-- ================================= -->

                            <Expander Header="File Cleaner"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}"

                                      Margin="0,0,0,8">

                                <StackPanel Margin="14">

                                    <TextBlock Text="Find and clean unnecessary files."

                                               FontSize="12"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Coming soon"

                                               Margin="0,10,0,0"

                                               FontSize="12"

                                               FontWeight="SemiBold"

                                               Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Expander>

                            <!-- ================================= -->

                            <!-- FEATURE 6 -->

                            <!-- ================================= -->

                            <Expander Header="More Automation Tools"

                                      Expanded="FeatureExpander_Expanded"

                                      Style="{StaticResource FeatureExpanderStyle}">

                                <StackPanel Margin="14">

                                    <TextBlock Text="Additional automation features will appear here."

                                               FontSize="12"

                                               Foreground="{StaticResource SecondaryTextBrush}"

                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Expander>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- ================================================= -->

            <!-- RIGHT RESULTS PANEL -->

            <!-- ================================================= -->

            <Border Grid.Column="2"

                    Background="{StaticResource SurfaceBrush}"

                    BorderBrush="{StaticResource BorderBrush}"

                    BorderThickness="1"

                    CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="76"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- Results header -->

                    <Grid Grid.Row="0"

                          Margin="22,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"

                                    VerticalAlignment="Center">

                            <TextBlock x:Name="ResultsTitleText"
                                       Text="Files"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock x:Name="ResultsSubtitleText"
                                       Text="Files found in the selected folder"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                        <!-- File count -->

                        <Border Grid.Column="1"

                                Background="{StaticResource SurfaceSecondaryBrush}"

                                CornerRadius="15"

                                Padding="11,5"

                                VerticalAlignment="Center">

                            <TextBlock x:Name="FileCountText"

                                       Text="0 files"

                                       FontSize="12"

                                       FontWeight="SemiBold"

                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </Border>

                    </Grid>

                    <!-- Files and organization preview -->

                    <Border Grid.Row="1"
                            Margin="18,0,18,18"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Existing file list -->

                            <DataGrid x:Name="FilesDataGrid"
                                      Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="42"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="250"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding FileType}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding Size}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Modified"
                                                        Binding="{Binding Modified}"
                                                        Width="180"/>
                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- Detailed organization preview -->

                            <DataGrid x:Name="OrganizationPreviewGrid"
                                      Grid.Row="0"
                                      Visibility="Collapsed"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="46"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File Name"
                                                        Binding="{Binding FileName}"
                                                        Width="180"
                                                        MinWidth="140"/>
                                    <DataGridTextColumn Header="Category"
                                                        Binding="{Binding Category}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Full Destination Path"
                                                        Binding="{Binding DestinationPath}"
                                                        Width="*"
                                                        MinWidth="300"/>
                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- Preview actions -->

                            <Border x:Name="PreviewActionsPanel"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Padding="14"
                                    Background="{StaticResource SurfaceSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="PreviewSummaryText"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Button Content="Cancel Preview"
                                                Height="36"
                                                Padding="12,0"
                                                Margin="0,0,8,0"
                                                Background="{StaticResource SurfaceBrush}"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Click="CancelPreviewButton_Click"/>

                                        <Button Content="Execute Organization"
                                                Height="36"
                                                Padding="14,0"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="{StaticResource OnPrimaryBrush}"
                                                BorderBrush="{StaticResource PrimaryBrush}"
                                                Click="ExecuteOrganizationButton_Click"/>

                                    </StackPanel>
                                </Grid>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

        <!-- ===================================================== -->

        <!-- STATUS BAR -->

        <!-- ===================================================== -->

        <Border Grid.Row="2"

                Background="{StaticResource SurfaceBrush}"

                BorderBrush="{StaticResource BorderBrush}"

                BorderThickness="0,1,0,0">

            <Grid Margin="16,0">

                <TextBlock Text="Folder Automation"

                           VerticalAlignment="Center"

                           FontSize="11"

                           Foreground="{StaticResource MutedTextBrush}"/>

                <TextBlock Text="Ready"

                           HorizontalAlignment="Right"

                           VerticalAlignment="Center"

                           FontSize="11"

                           Foreground="{StaticResource MutedTextBrush}"/>

            </Grid>

        </Border>

    </Grid>

</Window>