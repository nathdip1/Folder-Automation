<Window x:Class="FolderAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Automation"
        Height="760"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOP BAR -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Application identity -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Folder Automation"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Organize your files quickly and safely"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                </StackPanel>

                <!-- Application status -->
                <Border Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="16"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Ready"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="28,24,28,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- FOLDER CARD -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- Folder information -->

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Selected Folder"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="SelectedFolderText"
                                   Text="No folder selected"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>


                    <!-- Select folder -->

                    <Button Grid.Column="1"
                            Content="Select Folder"
                            Width="140"
                            Height="40"
                            Margin="20,0,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource OnPrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Click="SelectFolderButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- FILES CARD -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- FILE HEADER -->

                    <Grid Grid.Row="0"
                          Margin="22,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Files"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="Files found in the selected folder"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>


                        <!-- File count -->

                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                CornerRadius="15"
                                Padding="11,5"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="FileCountText"
                                       Text="0 files"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </Border>


                        <!-- Organize -->

                        <Button Grid.Column="2"
                                Content="Organize Files"
                                Width="135"
                                Height="38"
                                Margin="0,0,10,0"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource OnPrimaryBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Click="OrganizeFilesButton_Click"/>


                        <!-- Undo -->

                        <Button Grid.Column="3"
                                Content="Undo"
                                Width="82"
                                Height="38"
                                Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Click="UndoButton_Click"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- FILE TABLE -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Margin="18,0,18,18"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                        <DataGrid x:Name="FilesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="*"
                                                    MinWidth="250"/>

                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding FileType}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding Size}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Modified"
                                                    Binding="{Binding Modified}"
                                                    Width="180"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- STATUS BAR -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="28,0">

                <TextBlock Text="Folder Automation"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>

                <TextBlock Text="Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>

            </Grid>

        </Border>

    </Grid>

</Window>