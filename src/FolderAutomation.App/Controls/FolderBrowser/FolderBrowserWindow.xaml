<Window x:Class="FolderAutomation.Controls.FolderBrowser.FolderBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Folder"
        Width="760"
        Height="620"
        MinWidth="650"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">

            <StackPanel>

                <TextBlock Text="Select Folder"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Choose a folder to use with Folder Automation."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- FOLDER TREE -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Margin="24"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <TreeView x:Name="FolderTree"
                      BorderThickness="0"
                      Background="{StaticResource SurfaceBrush}"
                      Padding="8"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"/>

        </Border>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Selected path -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Selected folder"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="SelectedPathText"
                               Text="No folder selected"
                               Margin="0,2,20,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                </StackPanel>


                <!-- Cancel -->

                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="95"
                        Height="36"
                        Margin="8,0"
                        Click="CancelButton_Click"/>


                <!-- Select -->

                <Button Grid.Column="2"
                        Content="Select Folder"
                        Width="125"
                        Height="36"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource OnPrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        Click="SelectButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>