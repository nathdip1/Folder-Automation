<UserControl x:Class="FolderAutomation.Features.FileCleaner.FileCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Page heading -->
                <TextBlock Text="File Cleaner"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Review temporary files and other cleanup options before removing anything."
                           Margin="0,6,0,22"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <!-- Safety notice -->
                <Border Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Cleanup safety"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Files will be scanned and displayed for review before deletion. Files that are recently modified, in use, or inaccessible will be excluded or skipped."
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Available cleanup options -->
                <TextBlock Text="CLEANUP OPTIONS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,10"/>

                <!-- Windows temporary files -->
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0">

                            <TextBlock Text="Windows Temporary Files"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="Scan eligible temporary files in approved Windows and user temporary locations. Review the results before deciding what to remove."
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                            <TextBlock Text="Available"
                                       Margin="0,12,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Button x:Name="ScanTemporaryFilesButton"
                                Grid.Column="1"
                                Content="Scan Files"
                                MinWidth="110"
                                Height="40"
                                Padding="14,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource OnPrimaryBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Click="ScanTemporaryFilesButton_Click"/>
                    </Grid>
                </Border>

                <!-- Future options -->
                <TextBlock Text="MORE CLEANUP OPTIONS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,24,0,10"/>

                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Recycle Bin"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Optional permanent removal of all items in the Recycle Bin. This will require a separate explicit confirmation."
                                   Margin="0,7,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="Available during the Windows Temporary Files cleanup confirmation."
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Application Cache Files"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Review selected application cache locations before cleanup."
                                   Margin="0,7,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="Planned"
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                    <StackPanel>
                        <TextBlock Text="Downloads and Large Files"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Identify large files for manual review. Personal files will never be automatically removed by this option."
                                   Margin="0,7,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="Planned"
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <TextBlock x:Name="CleanerStatusText"
                           Text="Select Scan Files to inspect eligible temporary files."
                           Margin="0,20,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
