<UserControl x:Class="FolderAutomation.Features.FolderOrganizer.FolderOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultsTitleText"
                               Text="{Binding ResultsTitle}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="ResultsSubtitleText"
                               Text="{Binding ResultsSubtitle}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceSecondaryBrush}"
                        CornerRadius="15"
                        Padding="11,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="FileCountText"
                               Text="{Binding FileCountText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="18,0,18,18"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FilesDataGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Files}"
                              Visibility="{Binding IsFileListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="250" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="130" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="OrganizationPreviewGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding PreviewRows}"
                              Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="46"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="180" MinWidth="140" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Full Destination Path" Binding="{Binding DestinationPath}" Width="*" MinWidth="300" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="PreviewActionsPanel"
                            Grid.Row="1"
                            Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="14"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PreviewSummaryText"
                                       Grid.Column="0"
                                       Text="{Binding PreviewSummary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Cancel Preview"
                                        Height="36"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        Click="CancelPreviewButton_Click" />
                                <Button Content="Execute Organization"
                                        Height="36"
                                        Padding="14,0"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="{StaticResource OnPrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Click="ExecuteOrganizationButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
